# Optional. Copy to terraform.tfvars (gitignored) only to set the region explicitly.
# Race tuning (regions, GPU classes, lanes, context window, vLLM flags) lives in the drip-ai
# config file, not here: bin/drip-ai config show lists every key, and
# bin/drip-ai config import-tfvars moves tuning an older terraform.tfvars still holds.

# Keep region equal to the Region bin/drip-ai uses (DRIP_AI_REGION, default us-east-1):
# the state bucket and the shared stack live there, and a value here overrides the
# TF_VAR_region the helper exports.
region = "us-east-1"
