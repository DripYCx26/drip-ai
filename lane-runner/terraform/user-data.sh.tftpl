#!/bin/bash
# First-boot setup for the always-on lane runner. The container owns the lane
# runtime; this host only installs Docker, writes its environment, and keeps
# it alive under systemd.
set -euo pipefail
exec > >(tee -a /var/log/drip-ai-lane-runner-bootstrap.log) 2>&1

for tool in aws systemctl; do
  command -v "$tool" >/dev/null || {
    echo "lane-runner bootstrap: $tool missing from the AMI"
    exit 1
  }
done

dnf install -y docker
systemctl enable --now docker

runner_image=${jsonencode(runner_image)}
ranked_queue_uri=${jsonencode(ranked_queue_uri)}
model_endpoint_url=${jsonencode(model_endpoint_url)}
model_name=${jsonencode(model_name)}
endpoint_secret_parameter=${jsonencode(model_endpoint_secret_parameter)}
git_push_secret_parameter=${jsonencode(git_push_secret_parameter)}
endpoint_api_key=""
if [ -n "$endpoint_secret_parameter" ]; then
  endpoint_api_key="$(aws ssm get-parameter --region ${region} --name "$endpoint_secret_parameter" \
    --with-decryption --query Parameter.Value --output text)"
  [ -n "$endpoint_api_key" ] || {
    echo "lane-runner bootstrap: endpoint secret is empty"
    exit 1
  }
fi
git_push_token=""
if [ -n "$git_push_secret_parameter" ]; then
  git_push_token="$(aws ssm get-parameter --region ${region} --name "$git_push_secret_parameter" \
    --with-decryption --query Parameter.Value --output text)"
  [ -n "$git_push_token" ] || {
    echo "lane-runner bootstrap: Git push secret is empty"
    exit 1
  }
fi

install -d -m 700 /etc/drip-ai
kindness_state=/var/lib/drip-ai/kindness
install -d -m 700 /var/lib/drip-ai
if [ ! -d "$kindness_state/.git" ]; then
  image_container="$(docker create "$runner_image")"
  if ! docker cp "$image_container:/opt/drip-kindness/." "$kindness_state/"; then
    docker rm "$image_container" >/dev/null
    echo "lane-runner bootstrap: image has no /opt/drip-kindness checkout"
    exit 1
  fi
  docker rm "$image_container" >/dev/null
fi
rank_path="$kindness_state/seeds/library/build_rank.json"
rank_marker="$kindness_state/.ranked-queue-uri"
install -d -m 700 "$(dirname "$rank_path")"
if [ ! -f "$rank_path" ] || [ ! -f "$rank_marker" ] || [ "$(cat "$rank_marker")" != "$ranked_queue_uri" ]; then
  rank_temporary="$rank_path.tmp"
  aws s3 cp --region ${region} --only-show-errors "$ranked_queue_uri" "$rank_temporary"
  [ -s "$rank_temporary" ] || {
    echo "lane-runner bootstrap: ranked queue object is empty"
    exit 1
  }
  mv -f "$rank_temporary" "$rank_path"
  printf '%s' "$ranked_queue_uri" > "$rank_marker"
fi
env_file=/etc/drip-ai/lane-runner.env
umask 077
{
  printf '%s\n' "BUILD_LANES_ENABLED=%{ if lane_runner_enabled }1%{ else }0%{ endif }"
  printf '%s\n' "BUILD_LANE_COUNT=${lane_count}"
  printf '%s\n' "BUILD_RANKED_QUEUE_URI=$ranked_queue_uri"
  printf '%s\n' "AWS_DEFAULT_REGION=${region}"
  printf '%s\n' "BUILD_MODEL=$model_name"
  printf '%s\n' "OPENAI_BASE_URL=$model_endpoint_url"
  printf '%s\n' "OPENAI_API_KEY=$endpoint_api_key"
  printf '%s\n' "GIT_PUSH_TOKEN=$git_push_token"
} > "$env_file"

cat > /etc/systemd/system/drip-ai-lane-runner.service <<EOF_SERVICE
[Unit]
Description=drip-ai ranked build-lane runner
After=docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=/usr/bin/docker pull $runner_image
ExecStartPre=-/usr/bin/docker rm -f drip-ai-lane-runner
ExecStart=/usr/bin/docker run --rm --init --name drip-ai-lane-runner \
  --network host --env-file $env_file \
  --workdir /opt/drip-kindness \
  --mount type=bind,src=$kindness_state,dst=/opt/drip-kindness \
  $runner_image
ExecStop=/usr/bin/docker stop --time 30 drip-ai-lane-runner

[Install]
WantedBy=multi-user.target
EOF_SERVICE

systemctl daemon-reload
systemctl enable --now drip-ai-lane-runner.service
echo "lane-runner bootstrap: service enabled with $runner_image"
